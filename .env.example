# Copying this example is optional; the local setup helper generates a random
# password in the ignored .env file: python scripts/configure_local.py
# Never use this placeholder as an actual password or commit .env.
POSTGRES_USER=officeflow
POSTGRES_DB=officeflow
POSTGRES_PASSWORD=REPLACE_WITH_A_GENERATED_LOCAL_PASSWORD
FRONTEND_PORT=8080
API_PORT=8000
# Loopback HTTP only. Public deployment MUST use HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false
APP_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Optional private diagnostics credential; generate >=32 characters outside Git.
OPS_TOKEN=
